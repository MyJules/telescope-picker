{
  "name": "jules-telescope-picker",
  "displayName": "Telescope Pick",
  "description": "Fuzzy file picking and fast text search with live previews in the current code editor.",
  "version": "0.11.9",
  "publisher": "jules",
  "repository": {
    "type": "git",
    "url": "https://github.com/MyJules/telescope-picker.git"
  },
  "homepage": "https://github.com/MyJules/telescope-picker#readme",
  "bugs": {
    "url": "https://github.com/MyJules/telescope-picker/issues"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "File picking supports virtual workspaces. Text search can search their open documents only."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "telescopePicker.searchGitDiffs",
        "title": "Browse Git Changes",
        "category": "Telescope Picker",
        "icon": "$(git-compare)"
      },
      {
        "command": "telescopePicker.searchCurrentFile",
        "title": "Search Current File",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.configureShortcuts",
        "title": "Configure Keyboard Shortcuts",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.files",
        "title": "Find Files",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.searchContents",
        "title": "Search File Contents",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.resume",
        "title": "Resume Picker",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.openBeside",
        "title": "Open Selection Beside",
        "category": "Telescope Picker",
        "enablement": "telescopePicker.active"
      },
      {
        "command": "telescopePicker.next",
        "title": "Next Result",
        "category": "Telescope Picker",
        "enablement": "telescopePicker.active"
      },
      {
        "command": "telescopePicker.previous",
        "title": "Previous Result",
        "category": "Telescope Picker",
        "enablement": "telescopePicker.active"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "telescopePicker.searchGitDiffs",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "telescopePicker.next",
          "when": "false"
        },
        {
          "command": "telescopePicker.previous",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "telescopePicker.searchCurrentFile",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "!terminalFocus"
      },
      {
        "command": "telescopePicker.searchContents",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "!terminalFocus"
      },
      {
        "command": "telescopePicker.files",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "!terminalFocus"
      },
      {
        "command": "telescopePicker.openBeside",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "inQuickOpen && telescopePicker.active"
      },
      {
        "command": "telescopePicker.next",
        "key": "ctrl+j",
        "when": "inQuickOpen && telescopePicker.active && config.telescopePicker.vimNavigation"
      },
      {
        "command": "telescopePicker.previous",
        "key": "ctrl+k",
        "when": "inQuickOpen && telescopePicker.active && config.telescopePicker.vimNavigation"
      }
    ],
    "configuration": {
      "title": "Telescope Picker",
      "properties": {
        "telescopePicker.performanceDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Log search/update and content-row preparation timings to Telescope Picker Output. Does not log query text or measure native rendering or language-server work."
        },
        "telescopePicker.automaticPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically preview the selected result. Disable to reduce editor and language-server work; Enter still opens the selection."
        },
        "telescopePicker.previewDelay": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 2000,
          "description": "Wait this many milliseconds after selection settles before automatically previewing a result."
        },
        "telescopePicker.include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Folders or glob patterns to include in both Find Files and Search File Contents, relative to each workspace root. Empty means all eligible files. Examples: `src`, `include`, `**/*.cpp`. Existing VS Code ignore/exclude rules still apply."
        },
        "telescopePicker.exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Folders or glob patterns to exclude from both Find Files and Search File Contents, relative to each workspace root. Examples: `out`, `**/generated/**`. Exclusions win over includes; existing VS Code exclusions are also respected."
        },
        "telescopePicker.vimNavigation": {
          "type": "boolean",
          "default": false,
          "description": "Use Ctrl+J / Ctrl+K to navigate results while the search input stays focused."
        }
      }
    }
  },
  "scripts": {
    "package:all": "node scripts/package-all.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:host": "npm run build && node scripts/test-host.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "fuzzysort": "^4.0.2",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.108.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
