{
  "name": "telescope-picker",
  "displayName": "Telescope Picker",
  "description": "Fuzzy file picking and fast text search with live previews in the current code editor.",
  "version": "0.8.4",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "File picking supports virtual workspaces. Text search can search their open documents only."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "telescopePicker.files",
        "title": "Find Files",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.searchContents",
        "title": "Search File Contents",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.resume",
        "title": "Resume Picker",
        "category": "Telescope Picker"
      },
      {
        "command": "telescopePicker.openBeside",
        "title": "Open Selection Beside",
        "category": "Telescope Picker",
        "enablement": "telescopePicker.active"
      },
      {
        "command": "telescopePicker.next",
        "title": "Next Result",
        "category": "Telescope Picker",
        "enablement": "telescopePicker.active"
      },
      {
        "command": "telescopePicker.previous",
        "title": "Previous Result",
        "category": "Telescope Picker",
        "enablement": "telescopePicker.active"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "telescopePicker.next",
          "when": "false"
        },
        {
          "command": "telescopePicker.previous",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "telescopePicker.files",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "!terminalFocus"
      },
      {
        "command": "telescopePicker.openBeside",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "inQuickOpen && telescopePicker.active"
      },
      {
        "command": "telescopePicker.next",
        "key": "ctrl+j",
        "when": "inQuickOpen && telescopePicker.active && config.telescopePicker.vimNavigation"
      },
      {
        "command": "telescopePicker.previous",
        "key": "ctrl+k",
        "when": "inQuickOpen && telescopePicker.active && config.telescopePicker.vimNavigation"
      }
    ],
    "configuration": {
      "title": "Telescope Picker",
      "properties": {
        "telescopePicker.vimNavigation": {
          "type": "boolean",
          "default": false,
          "description": "Use Ctrl+J / Ctrl+K to navigate results while the search input stays focused."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:host": "npm run build && node scripts/test-host.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "fuzzysort": "^4.0.2",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.108.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
